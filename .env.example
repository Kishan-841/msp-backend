# ── MSP CRM backend — copy to .env and fill in ────────────────────────────────

# Public hostname of this API (DNS A record → this VM) — used in the nginx config / by Caddy.
API_DOMAIN=api.example.com
# Local port the API is published on (127.0.0.1 only). Pick one no other project uses.
API_PORT=5007

# Database (the compose file builds DATABASE_URL from these; outside Docker set DATABASE_URL yourself)
POSTGRES_DB=msp_crm
POSTGRES_USER=msp
POSTGRES_PASSWORD=change-me-long-random
# DATABASE_URL=postgresql://msp:password@localhost:5432/msp_crm   # only when running without Docker

# Secrets — long random strings, different from each other:  openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# The frontend's URL(s), comma-separated (e.g. the Vercel production URL and your own domain)
CORS_ORIGIN=https://your-app.vercel.app
# Frontend on another site than the API (Vercel + this VM) → none. Same site → lax.
COOKIE_SAMESITE=none

# First start on an empty database: creates this Admin (password ≥ 6 chars).
# Remove these two lines after logging in.
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# Email (optional — quotes / POs by email; without it emails are logged, not sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
